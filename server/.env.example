# Chép thành .env và điền giá trị thật. Không commit file .env.
LLV_ENV=dev
LLV_LOG_LEVEL=INFO

LLV_DATABASE_URL=postgresql+asyncpg://llvoice:llvoice@localhost:5432/llvoice
LLV_REDIS_URL=redis://localhost:6379/0

# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
LLV_JWT_SECRET=
# Khóa AES-256, sinh bằng: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
LLV_ENCRYPTION_KEY=

LLV_MINIMAX_BASE_URL=https://api.minimax.io
LLV_ADMIN_PATH=/admin
